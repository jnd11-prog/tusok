  <Item class="ReplicatedStorage" referent="RBX00000431">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX00000435">
      <Properties>
        <string name="Name">CartConfig</string>
        <ProtectedString name="Source"><![CDATA[-- TUSOK! / TAFT CART. Balancing values for a deliberately compact one-vendor shift.
local Config = {}
Config.ORDERS_PER_SHIFT = 8
Config.SHIFT_SECONDS = 510
Config.INITIAL_CASH = 278
Config.STARTING_STOCK = {kwek=5,fishball=6,kikiam=5}
Config.RESTOCK_QUANTITY = 3
Config.RESTOCK_COST = 28
Config.MAX_STOCK = 10
Config.FRY_GOOD_FROM = 4.0
Config.FRY_PERFECT_FROM = 4.8
Config.FRY_PERFECT_TO = 6.9
Config.FRY_BURN_AT = 9.0
Config.FLIP_FROM = 1.5
Config.FLIP_TO = 6.8
Config.DRAIN_TAPS = 2
Config.FOOD = {
 kwek={label="KWEK-KWEK",menu="2 PIECES",price=25,icon="● ●",color={237,116,37}},
 fishball={label="FISH BALL",menu="5 PIECES",price=18,icon="○ ○ ○",color={226,203,154}},
 kikiam={label="KIKIAM",menu="3 PIECES",price=22,icon="▰ ▰",color={166,97,54}},
}
Config.SAUCE = {Sweet="MATAMIS",Spicy="MAANGHANG",Vinegar="SUKA"}
Config.INITIAL_COINS = {[1]=18,[5]=10,[10]=8,[20]=4,[50]=1,[100]=0}
Config.CUSTOMERS = {
 {name="Mika",line="Ate, kwek-kwek. Suka lang, please. May quiz pa ako."},
 {name="Andre",line="Five fishball. Yung matamis. Sakto lang, may class."},
 {name="Paolo",line="Kikiam. Yung maanghang. Barya po."},
 {name="Iya",line="Pabili! Suka, tapos pakidamihan."},
 {name="Trish",line="Miss, isang fishball order. Do you have sukli?"},
 {name="Ren",line="Kwek-kwek na maanghang. Nagmamadali ako."},
 {name="Bea",line="Kikiam. Sweet sauce. May pila sa photocopy."},
 {name="Sam",line="Fishball ulit. Suka please. Last na 'to."},
}
-- Fixed first-order tutorial, with varied food and denomination pressure later.
Config.SHIFT_ORDERS = {
 {food="kwek",sauce="Vinegar",tender=50,wait=110},
 {food="fishball",sauce="Sweet",tender=20,wait=105},
 {food="kikiam",sauce="Spicy",tender=50,wait=100},
 {food="kwek",sauce="Vinegar",tender=100,wait=100},
 {food="fishball",sauce="Vinegar",tender=50,wait=94},
 {food="kwek",sauce="Spicy",tender=50,wait=90},
 {food="kikiam",sauce="Sweet",tender=100,wait=85},
 {food="fishball",sauce="Vinegar",tender=20,wait=88},
}
Config.DENOMINATIONS={1,5,10,20,50}
return Config
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX00000436">
      <Properties>
        <string name="Name">CartRules</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox-independent gameplay rules. All currency uses whole Philippine pesos.
local R={}
function R.quality(elapsed,flipped,good,perfectFrom,perfectTo,burn)
 if type(elapsed)~="number" or elapsed~=elapsed or elapsed<good then return "RAW" end
 if elapsed>=burn then return "BURNT" end
 if flipped and elapsed>=perfectFrom and elapsed<=perfectTo then return "PERFECT" end
 return "OK"
end
function R.canFlip(elapsed,hasFlipped,min,max)
 return type(elapsed)=="number" and elapsed>=min and elapsed<=max and not hasFlipped
end
function R.countChange(coins)
 if type(coins)~="table" then return nil end
 local total=0
 for denomination,n in pairs(coins) do
  if type(denomination)~="number" or type(n)~="number" or n<0 or n%1~=0 then return nil end
  if denomination~=1 and denomination~=5 and denomination~=10 and denomination~=20 and denomination~=50 then return nil end
  total+=denomination*n
 end
 return total
end
function R.affordableChange(drawer,selected,price,tender)
 if type(drawer)~="table" or type(selected)~="table" then return false,"bad drawer" end
 if type(price)~="number" or type(tender)~="number" or tender<price then return false,"invalid amount" end
 local counted=R.countChange(selected)
 if not counted or counted~=tender-price then return false,"wrong change" end
 for denom,n in pairs(selected) do
  if n>(drawer[denom] or 0) then return false,"not enough coins" end
 end
 return true,"ok"
end
function R.isServeable(order,ready,sauce,coins,drawer,now)
 if not order or order.paid or now>=order.expires then return false,"expired" end
 if (ready[order.food] or 0)<1 then return false,"food not ready" end
 if not sauce then return false,"no sauce" end
 return R.affordableChange(drawer,coins,order.price,order.tender)
end
-- Deduct an exact cash payment from the denomination drawer atomically.
-- This makes expenses and physical barya counts agree; no invisible infinite change.
function R.payFromDrawer(drawer,amount)
 if type(drawer)~="table" or type(amount)~="number" or amount<0 or amount%1~=0 then return nil end
 local denominations={100,50,20,10,5,1}
 local nextDrawer={}
 for k,v in pairs(drawer) do nextDrawer[k]=v end
 local function take(index,left)
  if left==0 then return true end
  if index>#denominations then return false end
  local denom=denominations[index]
  local available=nextDrawer[denom] or 0
  local maximum=math.min(available,math.floor(left/denom))
  for count=maximum,0,-1 do
   nextDrawer[denom]=available-count
   if take(index+1,left-denom*count) then return true end
  end
  nextDrawer[denom]=available
  return false
 end
 if take(1,amount) then return nextDrawer end
 return nil
end
function R.canRestock(stock,cash,cost,qty,maxStock)
 return type(stock)=="number" and stock<maxStock and cash>=cost and qty>0
end
function R.readyToLift(elapsed)
 return type(elapsed)=="number" and elapsed>=0
end
return R
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX00000432">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX00000437">
      <Properties>
        <string name="Name">CartServer</string>
        <ProtectedString name="Source"><![CDATA[-- TUSOK! / one vendor, one cart, one fryer. The server is the source of truth.
-- The action handler never yields between validating and changing a transaction.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Workspace=game:GetService("Workspace")
local Config=require(ReplicatedStorage:WaitForChild("CartConfig"))
local Rules=require(ReplicatedStorage:WaitForChild("CartRules"))

local signals=Instance.new("Folder")
signals.Name="CartSignals";signals.Parent=ReplicatedStorage
local Request=Instance.new("RemoteEvent")
Request.Name="Request";Request.Parent=signals
local Push=Instance.new("RemoteEvent")
Push.Name="Push";Push.Parent=signals

local vendor=nil
local shift=nil
local transactionSequence=0
local lastRemote={}
local lastSnapshot=0
local cart=Workspace:WaitForChild("TaftCart")
local interact=cart:WaitForChild("Hotspots")

local function cloneMap(t)
 local copy={}
 for k,v in pairs(t) do copy[k]=v end
 return copy
end
local function notify(message)
 if vendor and vendor.Parent==Players then
  Push:FireClient(vendor,{kind="Toast",text=message})
 end
end
local function readyCounts()
 local counts={kwek=0,fishball=0,kikiam=0}
 if shift then
  for food,portions in pairs(shift.prepared) do counts[food]=#portions end
 end
 return counts
end
local function snapshot()
 if not shift then return {phase="idle"} end
 local coinView={}
 -- RemoteEvent dictionaries are sent with STRING keys. Numeric sparse keys can be lost.
 for _,denom in ipairs(Config.DENOMINATIONS) do
  coinView[tostring(denom)]=shift.coins[denom] or 0
 end
 local c=shift.cooking
 local cooking=nil
 if c then
  cooking={food=c.food,stage=c.stage,session=c.session,drained=c.drained,
   flipped=c.flipped,elapsed=c.started and math.max(0,os.clock()-c.started) or 0,
   quality=c.quality}
 end
 local o=shift.order
 local order=nil
 if o then
  order={id=o.id,number=o.number,food=o.food,sauce=o.sauce,
   price=o.price,tender=o.tender,change=o.tender-o.price,
   name=o.name,line=o.line,remaining=math.max(0,o.expires-os.clock()),
   duration=o.duration}
 end
 return {phase=shift.phase,order=order,cooking=cooking,
  stock=cloneMap(shift.stock),prepared=readyCounts(),coins=coinView,
  sauce=shift.sauce,served=shift.served,missed=shift.missed,burnt=shift.burnt,
  sales=shift.sales,tips=shift.tips,spent=shift.spent,cash=shift.cash,
  count=shift.count,shiftLeft=math.max(0,Config.SHIFT_SECONDS-(os.clock()-shift.started)),
  paymentOpen=shift.pending~=nil}
end
local function sync()
 if vendor and vendor.Parent==Players then
  Push:FireClient(vendor,{kind="State",data=snapshot()})
 end
end
local function finishShift()
 if not shift or shift.phase~="active" then return end
 shift.phase="ended";shift.order=nil;shift.cooking=nil;shift.pending=nil
 notify("SARADO NA. Bumalik si Ate Bebang. May dala siyang yelo.")
 sync()
end
local function nextOrder()
 if not shift or shift.phase~="active" then return end
 if shift.count>=Config.ORDERS_PER_SHIFT or os.clock()-shift.started>=Config.SHIFT_SECONDS then
  finishShift();return
 end
 shift.count+=1
 transactionSequence+=1
 local n=shift.count
 local spec=Config.SHIFT_ORDERS[n]
 local customer=Config.CUSTOMERS[n]
 local price=Config.FOOD[spec.food].price
 shift.order={id=transactionSequence,number=n,food=spec.food,
  sauce=spec.sauce,price=price,tender=spec.tender,
  name=customer.name,line=customer.line,paid=false,
  duration=spec.wait,expires=os.clock()+spec.wait}
 shift.sauce=nil;shift.pending=nil
 sync()
 if n==5 then notify("Rush hour. May bagong dismissal sa gate.") end
end
local function startShift(player)
 if player~=vendor then return end
 if shift and shift.phase=="active" then sync();return end
 shift={phase="active",started=os.clock(),cash=Config.INITIAL_CASH,
  sales=0,tips=0,spent=0,served=0,missed=0,burnt=0,count=0,
  stock=cloneMap(Config.STARTING_STOCK),prepared={kwek={},fishball={},kikiam={}},
  coins=cloneMap(Config.INITIAL_COINS),cooking=nil,order=nil,
  pending=nil,sauce=nil,cookSequence=0}
 notify("5:17 PM. Ate Bebang went to buy ice. Ikaw muna.")
 nextOrder()
end
local function startFry(food)
 if not Config.FOOD[food] then return end
 if shift.cooking then notify("May nakasalang na. Isa lang ang kawali.");return end
 if shift.stock[food]<=0 then notify("Ubos ang "..Config.FOOD[food].label..". Mag-restock muna.");return end
 if #shift.prepared[food]>=4 then notify("Puno na ang tray. Serve muna.");return end
 shift.stock[food]-=1
 shift.cookSequence+=1
 shift.cooking={food=food,stage="READY",session=shift.cookSequence,
  drained=0,flipped=false,quality=nil,started=nil}
 sync()
end
local function drop(session)
 local c=shift.cooking
 if not c or c.session~=session or c.stage~="READY" then return end
 c.stage="FRYING";c.started=os.clock()
 sync()
end
local function flip(session)
 local c=shift.cooking
 if not c or c.session~=session or c.stage~="FRYING" then return end
 local elapsed=os.clock()-c.started
 if not Rules.canFlip(elapsed,c.flipped,Config.FLIP_FROM,Config.FLIP_TO) then
  notify("Hintay ng konti bago baliktarin. Isang beses lang.");return
 end
 c.flipped=true
 notify("Nabaliktad. Bantayan ang oil.")
 sync()
end
local function lift(session)
 local c=shift.cooking
 if not c or c.session~=session or c.stage~="FRYING" then return end
 local q=Rules.quality(os.clock()-c.started,c.flipped,
  Config.FRY_GOOD_FROM,Config.FRY_PERFECT_FROM,Config.FRY_PERFECT_TO,Config.FRY_BURN_AT)
 if q=="RAW" then notify("Hilaw pa. Hintayin mong umangat at magkulay.");return end
 if q=="BURNT" then
  shift.burnt+=1;shift.cooking=nil
  notify("Sunog. Sayang ang stock. Try ulit.")
 else
  c.stage="DRAIN";c.quality=q;c.drained=0;c.lastDrain=0
  notify(q=="PERFECT" and "Ang ganda ng luto. Patuluin muna ang mantika." or "Pwede na. Patuluin muna.")
 end
 sync()
end
local function drain(session)
 local c=shift.cooking
 if not c or c.session~=session or c.stage~="DRAIN" then return end
 if os.clock()-(c.lastDrain or 0)<.19 then return end
 c.lastDrain=os.clock();c.drained+=1
 if c.drained>=Config.DRAIN_TAPS then
  table.insert(shift.prepared[c.food],c.quality)
  local food=Config.FOOD[c.food].label
  shift.cooking=nil
  notify(food.." on the tray. Pili ng sawsawan.")
 end
 sync()
end
local function cancelCook()
 local c=shift.cooking
 if not c then return end
 if c.stage=="READY" then
  shift.stock[c.food]+=1
 else
  shift.burnt+=1
 end
 shift.cooking=nil
 notify("Tinabi ang batch.")
 sync()
end
local function selectSauce(sauce)
 if not Config.SAUCE[sauce] then return end
 shift.sauce=sauce;shift.pending=nil
 notify("SAWSAWAN: "..Config.SAUCE[sauce])
 sync()
end
local function restock(food)
 if not Config.FOOD[food] then return end
 if not Rules.canRestock(shift.stock[food],shift.cash,Config.RESTOCK_COST,
  Config.RESTOCK_QUANTITY,Config.MAX_STOCK) then
  notify("Kulang sa kaha o puno na ang stock.");return
 end
 local paidDrawer=Rules.payFromDrawer(shift.coins,Config.RESTOCK_COST)
 if not paidDrawer then notify("Walang eksaktong ₱28 sa kaha. Kailangan ng barya.");return end
 shift.coins=paidDrawer
 shift.cash-=Config.RESTOCK_COST;shift.spent+=Config.RESTOCK_COST
 shift.stock[food]=math.min(Config.MAX_STOCK,shift.stock[food]+Config.RESTOCK_QUANTITY)
 notify("+3 portions: "..Config.FOOD[food].label..". ₱28 gastos.")
 sync()
end
local function beginSale()
 local o=shift.order
 if not o then notify("Wala pang customer.");return end
 if #shift.prepared[o.food]<1 then notify("Wala pang lutong "..Config.FOOD[o.food].label..".");return end
 if not shift.sauce then notify("Sawsawan muna. Anong sauce ang gusto niya?");return end
 if shift.sauce~=o.sauce then
  notify("Ibang sauce! Kailangan "..Config.SAUCE[o.sauce]..".")
  return
 end
 shift.pending={orderId=o.id,opened=os.clock()}
 Push:FireClient(vendor,{kind="Payment",orderId=o.id,price=o.price,
  tender=o.tender,due=o.tender-o.price})
 sync()
end
local function settle(id,coins)
 local o=shift.order
 if not o or o.id~=id then notify("Lumang resibo na 'yan.");return end
 if not shift.pending or shift.pending.orderId~=id or
  os.clock()-shift.pending.opened>45 then notify("Serve muna bago bilang ng barya.");return end
 if type(coins)~="table" then return end
 local sanitized={}
 for i,denom in ipairs(Config.DENOMINATIONS) do
  local n=coins[i] or 0
  if type(n)~="number" or n<0 or n>30 or n%1~=0 then return end
  sanitized[denom]=n
 end
 -- Whitelist exact keys; ignore rogue keys rather than allow crafted denominations.
 if shift.sauce~=o.sauce then
  notify("Sawsawan mali! Gusto niya "..Config.SAUCE[o.sauce]..".")
  shift.pending=nil
  sync()
  return
 end
 local ok,reason=Rules.isServeable(o,readyCounts(),shift.sauce,sanitized,
  shift.coins,os.clock())
 if not ok then
  notify(reason=="wrong change" and "Mali ang sukli. Bilang ulit." or
   reason=="not enough coins" and "Kulang ang barya sa kaha." or
   "Hindi pa ready ang order: "..reason)
  return
 end
 -- Atomic: no yielding after validation, no second client request can settle it.
 o.paid=true
 local quality=table.remove(shift.prepared[o.food],1)
 local correctSauce=true
 local tip=quality=="PERFECT" and 2 or 0
 for denom,n in pairs(sanitized) do
  shift.coins[denom]-=n
 end
 shift.coins[o.tender]=(shift.coins[o.tender] or 0)+1
 if tip>0 then shift.coins[1]=(shift.coins[1] or 0)+tip end
 shift.cash+=o.price+tip;shift.sales+=o.price;shift.tips+=tip
 shift.served+=1;shift.order=nil;shift.pending=nil;shift.sauce=nil
 notify("Salamat po! ₱"..o.price..(tip>0 and " + ₱2 tip" or "")..".")
 sync()
 task.delay(1.1,function()
  if shift and shift.phase=="active" and not shift.order then nextOrder() end
 end)
end
local function handle(player,data)
 if player~=vendor then return end
 local action=data.action
 if action=="Sync" then sync();return end
 if action=="StartShift" then startShift(player);return end
 if not shift or shift.phase~="active" then return end
 if os.clock()-shift.started>=Config.SHIFT_SECONDS then finishShift();return end
 if action=="StartFry" and type(data.food)=="string" then startFry(data.food)
 elseif action=="Drop" then drop(data.session)
 elseif action=="Flip" then flip(data.session)
 elseif action=="Lift" then lift(data.session)
 elseif action=="Drain" then drain(data.session)
 elseif action=="Cancel" then cancelCook()
 elseif action=="Sauce" and type(data.sauce)=="string" then selectSauce(data.sauce)
 elseif action=="Serve" then beginSale()
 elseif action=="Settle" and type(data.orderId)=="number" then settle(data.orderId,data.coins)
 elseif action=="Restock" and type(data.food)=="string" then restock(data.food)
 end
end
Request.OnServerEvent:Connect(function(player,data)
 if type(data)~="table" or type(data.action)~="string" or #data.action>18 then return end
 local now=os.clock()
 if now-(lastRemote[player] or 0)<.07 then return end
 lastRemote[player]=now
 local ok,err=pcall(handle,player,data)
 if not ok then warn("[TUSOK CART]",err);notify("May problem sa cart. View → Output.") end
end)
local hotspots={Kwek="kwek",Fish="fishball",Kikiam="kikiam"}
for name,food in pairs(hotspots) do
 local obj=interact:FindFirstChild(name)
 local click=obj and obj:FindFirstChildOfClass("ClickDetector")
 if click then
  click.MouseClick:Connect(function(player)
   if player==vendor and shift and shift.phase=="active" then startFry(food) end
  end)
 end
end
for name,sauce in pairs({Sweet="Sweet",Spicy="Spicy",Vinegar="Vinegar"}) do
 local obj=interact:FindFirstChild(name)
 local click=obj and obj:FindFirstChildOfClass("ClickDetector")
 if click then
  click.MouseClick:Connect(function(player)
   if player==vendor and shift and shift.phase=="active" then selectSauce(sauce) end
  end)
 end
end
Players.PlayerAdded:Connect(function(p)
 if not vendor then vendor=p end
 task.delay(1.6,function()
  if p.Parent~=Players then return end
  if p==vendor then Push:FireClient(p,{kind="State",data=snapshot()})
  else Push:FireClient(p,{kind="State",data={phase="spectator"}}) end
 end)
end)
Players.PlayerRemoving:Connect(function(p)
 lastRemote[p]=nil
 if p==vendor then
  vendor=nil;shift=nil
  for _,other in ipairs(Players:GetPlayers()) do
   if other~=p then vendor=other;Push:FireClient(other,{kind="State",data={phase="idle"}});break end
  end
 end
end)
task.spawn(function()
 while true do
  task.wait(.3)
  if shift and shift.phase=="active" then
   local t=os.clock()
   if t-shift.started>=Config.SHIFT_SECONDS then finishShift()
   else
    local c=shift.cooking
    if c and c.stage=="FRYING" and t-c.started>=Config.FRY_BURN_AT then
     shift.cooking=nil;shift.burnt+=1
     notify("NASUNOG! Nalimutan mo ang kawali.")
    end
    local order=shift.order
    if order and t>=order.expires then
     shift.missed+=1;shift.order=nil;shift.pending=nil;shift.sauce=nil
     notify("Umalis na ang customer. May next pa.")
     task.delay(1.3,function()
      if shift and shift.phase=="active" and not shift.order then nextOrder() end
     end)
    end
    if t-lastSnapshot>.6 then lastSnapshot=t;sync() end
   end
  end
 end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX00000438">
      <Properties>
        <string name="Name">CartSelfTest</string>
        <ProtectedString name="Source"><![CDATA[-- Runs when pressing Play in Studio, not in production published servers.
if not game:GetService("RunService"):IsStudio() then return end
local Config=require(game:GetService("ReplicatedStorage"):WaitForChild("CartConfig"))
local R=require(game:GetService("ReplicatedStorage"):WaitForChild("CartRules"))
local n=0
local function ok(condition,message)
 n+=1;assert(condition,"[TUSOK SELF TEST] "..message)
end
ok(R.quality(3,true,4,4.8,6.9,9)=="RAW","no raw sales")
ok(R.quality(5.1,true,4,4.8,6.9,9)=="PERFECT","perfect fry")
ok(R.quality(5.1,false,4,4.8,6.9,9)=="OK","flip affects quality")
ok(R.quality(9,true,4,4.8,6.9,9)=="BURNT","burn timeout")
ok(not R.canFlip(1,false,1.5,6.8),"early flip")
ok(R.canFlip(3,false,1.5,6.8),"valid flip")
ok(not R.canFlip(3,true,1.5,6.8),"one flip only")
ok(R.countChange({[20]=1,[5]=1})==25,"count change")
ok(R.countChange({[2]=1})==nil,"reject unknown denominations")
ok(R.countChange({[1]=-1})==nil,"reject negative denominations")
local drawer=Config.INITIAL_COINS
local c={ [20]=1,[5]=1 }
local valid=R.affordableChange(drawer,c,25,50)
ok(valid,"correct 25 change")
local bad=R.affordableChange(drawer,{[20]=1},25,50)
ok(not bad,"reject incorrect change")
local shortage=R.affordableChange({[20]=0,[5]=0},{[20]=1,[5]=1},25,50)
ok(not shortage,"reject phantom coins")
local order={id=12,food="kwek",sauce="Vinegar",price=25,tender=50,expires=100,paid=false}
ok(R.isServeable(order,{kwek=1},"Vinegar",c,drawer,5),"normal settlement")
order.paid=true
ok(not R.isServeable(order,{kwek=1},"Vinegar",c,drawer,5),"duplicate settlement")
order.paid=false
ok(not R.isServeable(order,{kwek=0},"Vinegar",c,drawer,5),"no phantom food")
ok(not R.isServeable(order,{kwek=1},nil,c,drawer,5),"sauce needed")
ok(not R.isServeable(order,{kwek=1},"Vinegar",c,drawer,100),"expired order")
ok(R.canRestock(0,120,28,3,10),"restock empty")
ok(not R.canRestock(10,120,28,3,10),"cannot overfill")
local initial=R.payFromDrawer(Config.INITIAL_COINS,28)
ok(initial~=nil,"exact supply payment")
ok(R.countChange({[20]=1,[5]=1})==25,"still counts change")
ok(R.payFromDrawer({[1]=2},28)==nil,"cannot create change")
local initialTotal=0
for denom,count in pairs(Config.INITIAL_COINS) do
 initialTotal+=denom*count
end
ok(initialTotal==Config.INITIAL_CASH,"cash drawer matches cash value")
print("[TUSOK SELF TEST] passed "..n.." rules checks")
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX00000433">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX00000434">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX00000439">
        <Properties>
          <string name="Name">CartClient</string>
          <ProtectedString name="Source"><![CDATA[-- TUSOK! / TAFT CART. All-UI solo vendor controls + 3D clickable food/sauces.
-- Completely new screen architecture: translucent ink panels, analog receipt and oil timing.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local TweenService=game:GetService("TweenService")
local Config=require(ReplicatedStorage:WaitForChild("CartConfig"))
local player=Players.LocalPlayer
local signals=ReplicatedStorage:WaitForChild("CartSignals")
local Request=signals:WaitForChild("Request")
local Push=signals:WaitForChild("Push")

-- Values sampled/selected from the actual reference collage, never a neon stock game palette.
local C={
 ink=Color3.fromRGB(26,29,28), steel=Color3.fromRGB(57,65,64),
 concrete=Color3.fromRGB(129,113,89), paper=Color3.fromRGB(216,193,159),
 ivory=Color3.fromRGB(251,237,210), orange=Color3.fromRGB(225,110,39),
 fried=Color3.fromRGB(195,65,21), blue=Color3.fromRGB(39,80,125),
 fadedRed=Color3.fromRGB(146,24,13), green=Color3.fromRGB(51,112,78),
 acid=Color3.fromRGB(199,214,18), white=Color3.fromRGB(250,246,234),
 warm=Color3.fromRGB(178,137,95), fish=Color3.fromRGB(224,200,155),
}
local function add(cls,parent,properties)
 local obj=Instance.new(cls)
 if obj:IsA("GuiObject") and parent and parent:IsA("GuiObject") then
  obj.ZIndex=parent.ZIndex+1
 end
 for k,v in pairs(properties or {}) do obj[k]=v end
 obj.Parent=parent
 return obj
end
local function rounded(obj,r)
 add("UICorner",obj,{CornerRadius=UDim.new(0,r or 10)})
 return obj
end
local function line(obj,color,thickness,alpha)
 add("UIStroke",obj,{Color=color or C.warm,Thickness=thickness or 1,Transparency=alpha or .55})
 return obj
end
local function panel(parent,pos,size,alpha,bg,r,z)
 local obj=add("Frame",parent,{Position=pos,Size=size,BackgroundColor3=bg or C.ink,
  BackgroundTransparency=alpha or 0,BorderSizePixel=0,ZIndex=z or 2})
 rounded(obj,r or 13)
 return obj
end
local function label(parent,str,x,y,w,h,size,color,bold,align)
 return add("TextLabel",parent,{Text=str,Position=UDim2.fromOffset(x,y),Size=UDim2.new(w==0 and 1 or w,(w==0 or w==1) and (-x-12) or 0,0,h),
  BackgroundTransparency=1,TextColor3=color or C.white,
  Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham,
  TextSize=size or 16,TextWrapped=true,
  TextXAlignment=align or Enum.TextXAlignment.Left,
  TextYAlignment=Enum.TextYAlignment.Center})
end
local function btn(parent,str,pos,size,bg,fg)
 local b=add("TextButton",parent,{Text=str,Position=pos,Size=size,
  BackgroundColor3=bg or C.steel,TextColor3=fg or C.white,
  Font=Enum.Font.GothamBold,TextSize=14,TextWrapped=true,
  AutoButtonColor=true,BorderSizePixel=0})
 rounded(b,9)
 return b
end
local function send(action,additional)
 local d=additional or {}
 d.action=action
 Request:FireServer(d)
end
local ui=add("ScreenGui",player:WaitForChild("PlayerGui"),{
 Name="TUSOK_TAFT_REBUILT_UI",IgnoreGuiInset=true,ResetOnSpawn=false,
 DisplayOrder=55,ZIndexBehavior=Enum.ZIndexBehavior.Global})
local root=add("Frame",ui,{BackgroundTransparency=1,Size=UDim2.fromScale(1,1)})
local scale=add("UIScale",root,{Scale=1})

-- GROUND-LEVEL CAMERA: a compact cart in foreground, Taft traffic and students beyond.
-- This isn't a fake background image: it is the real saved editable Workspace.
local camera=workspace.CurrentCamera
local function setCamera()
 camera=workspace.CurrentCamera
 if not camera then return end
 camera.CameraType=Enum.CameraType.Scriptable
 camera.FieldOfView=64
 camera.CFrame=CFrame.lookAt(Vector3.new(0,7.25,-17.4),Vector3.new(0,3.25,2.8))
end
setCamera()

local brand=panel(root,UDim2.fromOffset(20,16),UDim2.fromOffset(267,112),.13,C.ink,11,3)
local orangeStripe=panel(brand,UDim2.fromOffset(12,13),UDim2.fromOffset(6,77),0,C.orange,2,5)
label(brand,"TUSOK!",31,10,1,52,42,C.orange,true)
label(brand,"TAFT / ONE-MAN SHIFT",32,62,1,21,12,C.ivory,true)
label(brand,"ate bebang's cart · vito cruz side",32,83,1,18,11,C.paper)
local topBar=panel(root,UDim2.new(1,-266,0,17),UDim2.fromOffset(246,66),.18,C.ink,12,3)
label(topBar,"DAY 01    ·    DLSU TAFT",15,8,1,18,11,C.paper,true)
local currentTime=label(topBar,"5:17 PM",15,24,1,34,23,C.ivory,true)

local ticket=panel(root,UDim2.fromOffset(20,143),UDim2.fromOffset(302,271),.15,C.ink,13,3)
line(ticket,C.warm,1,.72)
label(ticket,"●  CURRENT ORDER",16,8,1,24,12,C.ivory,true)
local ticketNumber=label(ticket,"#001",230,8,0,25,12,C.paper,true,Enum.TextXAlignment.Right)
local ticketDivider=add("Frame",ticket,{Position=UDim2.fromOffset(15,39),Size=UDim2.new(1,-30,0,1),BackgroundColor3=C.warm,BackgroundTransparency=.72})
